# ==================================
# LOCAL SUPABASE ENVIRONMENT VARIABLES
# ==================================
# This file is for local development with Supabase running locally.
# Copy this file to .env.local and update the values after running `npm run supabase:start`

# Local Supabase Configuration
# These are the default values for a local Supabase instance
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=____________________________________.________________________________________________________________________.___________________________________________
SUPABASE_SERVICE_KEY=____________________________________.___________________________________________________________________________________.___________________________________________

# JWT Secret for local Supabase
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Application Port
PORT=3000

# Telegram Bot Configuration
# Option 1: Use a separate test bot for local development (recommended)
# Create a test bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_test_bot_token_here
TELEGRAM_BOT_USERNAME=jamia_notifications_bot
TELEGRAM_POLLING=true 

# Option 2: Use the same production bot (not recommended)
# TELEGRAM_BOT_TOKEN=your_production_bot_token

# Resend API (if using email features locally)
# You can use the same API key or a test key
RESEND_API_KEY=re_your_resend_api_key

# ==========================================
# AFTER RUNNING `npm run supabase:start`:
# ==========================================
# 
# You can access:
# - Supabase Studio (Database UI): http://127.0.0.1:54323
# - API URL: http://127.0.0.1:54321
# - PostgreSQL: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# 
# The keys above are Supabase's default local development credentials.
# They are safe to commit to your repository and are used by all local Supabase instances.
