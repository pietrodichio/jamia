{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@jamia/types/(.*)$": "<rootDir>/../../packages/types/src/$1.ts",
    "^@jamia/types$": "<rootDir>/../../packages/types/src/index.ts"
  }
}
