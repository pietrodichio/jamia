{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "style": {
        "useImportType": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      }
    },
    "domains": { "test": "recommended" }
  },
  "files": {
    "includes": ["src/**/*.{ts,tsx,js,jsx}", "supabase/**/*.sql", "!src/components/ui"]
  }
}
