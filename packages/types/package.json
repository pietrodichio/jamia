{
  "name": "@jamia/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types for Jamia monorepo",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jam": {
      "types": "./dist/jam.d.ts",
      "default": "./dist/jam.js"
    },
    "./participant": {
      "types": "./dist/participant.d.ts",
      "default": "./dist/participant.js"
    },
    "./event": {
      "types": "./dist/event.d.ts",
      "default": "./dist/event.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "default": "./dist/profile.js"
    },
    "./email-preferences": {
      "types": "./dist/email-preferences.d.ts",
      "default": "./dist/email-preferences.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
